# Copy to .env (gitignored) and fill in. NEVER commit real values.

# Deployer private key (hex, no 0x prefix needed). Used only to pay deploy gas;
# the full token supply mints to RECIPIENT, not the deployer.
PRIVATE_KEY=

# Arbitrum One RPC (defaults to the public endpoint if unset).
ARBITRUM_MAINNET_RPC_URL=https://arb1.arbitrum.io/rpc

# Etherscan V2 API key (works for Arbiscan) — for `hardhat verify`.
ETHERSCAN_API_KEY=

# Optional: override the supply recipient at deploy time.
# RECIPIENT_ADDRESS=0x...
